  },
  "scripts": {
    "test": "bun test ./test/*.bun.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov ./test/*.bun.ts",
    "typecheck": "tsc --noEmit",
    "bench": "bun run ./bench/replay.ts",
    "package:check": "npm run typecheck && node ./scripts/check-package.mjs && bun test ./test/*.bun.ts"
  },
  "sideEffects": false
