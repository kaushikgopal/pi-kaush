{
  "name": "@pi-kaush/pi-inline-identifier",
  "version": "0.1.0",
  "description": "Highlight and route inline Pi skill, agent, and prompt identifiers.",
  "license": "MIT",
  "author": "Kaushik Gopal",
  "type": "module",
  "exports": {
    "./skill": "./src/skill.ts",
    "./agent": "./src/agent.ts",
    "./prompt": "./src/prompt.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "inline-aliases",
    "skills",
    "subagents",
    "prompt-templates"
  ],
  "homepage": "https://github.com/kaushikgopal/pi-kaush/tree/main/extensions/pi-inline-identifier#readme",
  "bugs": {
    "url": "https://github.com/kaushikgopal/pi-kaush/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaushikgopal/pi-kaush.git",
    "directory": "extensions/pi-inline-identifier"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/skill.ts",
      "./src/agent.ts",
      "./src/prompt.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": ">=0.80.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "package:check": "node ./scripts/check-package.mjs"
  },
  "sideEffects": false
}
