{
  "name": "@pi-kaush/pi-firefox",
  "version": "0.1.0",
  "description": "Thin Pi-native status adapter for Firefox CLI and its native host.",
  "license": "MIT",
  "author": "Kaushik Gopal",
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "firefox",
    "browser",
    "status"
  ],
  "homepage": "https://github.com/kaushikgopal/pi-kaush/tree/main/extensions/pi-firefox#readme",
  "bugs": {
    "url": "https://github.com/kaushikgopal/pi-kaush/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaushikgopal/pi-kaush.git",
    "directory": "extensions/pi-firefox"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@pi-kaush/firefox-core": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "package:check": "node ./scripts/check-package.mjs"
  },
  "sideEffects": false
}
