{
  "name": "@pi-kaush/firefox-agent-core",
  "version": "0.1.0",
  "description": "Harness-neutral Firefox sessions and compact reads through firefox-cli.",
  "license": "MIT",
  "author": "Kaushik Gopal",
  "type": "module",
  "main": "./dist/index.js",
